<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <application tools:ignore="MissingApplicationIcon">
        <service
            android:name="com.x8bit.bitwarden.data.wear.WearDeliveryListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/bitwarden/wear/data/v1/receipts/" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.CAPABILITY_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/bitwarden_wear_companion_v1" />
            </intent-filter>
        </service>
        <!-- Isolated persistent synthetic outbox and assets; no vault item access. -->
        <activity
            android:name="com.x8bit.bitwarden.data.wear.WearPersistentProbeActivity"
            android:exported="true"
            android:taskAffinity="${applicationId}.wear.persistent.probe"
            android:noHistory="true"
            android:excludeFromRecents="true" />
        <!-- Explicit synthetic transport test; never accesses vault items. -->
        <activity
            android:name="com.x8bit.bitwarden.data.wear.WearSnapshotProbeActivity"
            android:exported="true"
            android:taskAffinity="${applicationId}.wear.snapshot.probe"
            android:noHistory="true"
            android:excludeFromRecents="true" />
        <service
            android:name="com.x8bit.bitwarden.data.wear.WearConnectionListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/bitwarden/wear/connection/v1/ping" />
            </intent-filter>
        </service>
        <service
            android:name="com.x8bit.bitwarden.data.push.BitwardenFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <!-- Disable Crashlytics for debug builds -->
        <meta-data
            android:name="firebase_crashlytics_collection_enabled"
            android:value="false" />
    </application>

</manifest>
