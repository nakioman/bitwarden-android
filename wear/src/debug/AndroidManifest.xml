<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Persistent synthetic assets; isolated from production keys and caches. -->
        <service
            android:name=".debug.WearPersistentProbeService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/bitwarden/wear/probe/data/v1/packets/" />
            </intent-filter>
        </service>
        <activity
            android:name=".debug.WatchSnapshotReadProbeActivity"
            android:exported="true"
            android:taskAffinity="${applicationId}.wear.snapshot.probe"
            android:noHistory="true"
            android:excludeFromRecents="true" />
        <service
            android:name=".debug.WearSnapshotProbeService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.REQUEST_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:pathPrefix="/bitwarden/wear/probe/snapshot/v1/" />
            </intent-filter>
        </service>
        <!-- Synthetic data only; separate from companion keys and snapshots. -->
        <activity
            android:name=".debug.WatchStorageProbeActivity"
            android:exported="true"
            android:taskAffinity="${applicationId}.wear.storage.probe"
            android:noHistory="true"
            android:excludeFromRecents="true" />
        <!-- Debug-only entry point for an explicit ADB connection check. -->
        <activity
            android:name=".debug.WearConnectionProbeActivity"
            android:exported="true"
            android:taskAffinity="${applicationId}.wear.connection"
            android:noHistory="true"
            android:excludeFromRecents="true" />
        <service
            android:name=".debug.WearConnectionListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
                <data
                    android:scheme="wear"
                    android:host="*"
                    android:path="/bitwarden/wear/connection/v1/pong" />
            </intent-filter>
        </service>
    </application>
</manifest>
